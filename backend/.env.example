# Tavily API Key (Optional: for real-time web retrieval. Defaults to Wikipedia API if absent)
TAVILY_API_KEY=your_tavily_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
